# Python
.venv/
__pycache__/
*.pyc

# Databases (runtime state)
*.db
*.db-wal
*.db-shm

# Server secrets / env (admin key, etc.) — never commit
.env
# operator page key (server/operator.key, or wherever HYRULELINK_OPERATOR_KEY_FILE points)
server/operator.key
*.key

# deploy/deploy.sh markers (droplet side): the rollback commit, the unit that
# deploy replaced, and a deploy that has not finished
.deploy-prev
.deploy-prev.service
.deploy-pending

# Claude Code agent worktrees
.claude/worktrees/

# Local agent config & secrets (contain player tokens + machine paths)
agent/config.json
agent/config_a.json
agent/config_b.json
agent/gui_settings.json

# Downloaded binaries (source adapters and connector assets remain tracked)
tools/cloudflared.exe
tools/sni/sni.exe

# ROM seeds (copyrighted; generate locally)
seeds/
*.sfc
*.smc

# Downloaded sprite catalog/preview/.zspr cache + reskin preview render
agent/cache/
agent/romtools/npc_sprite/out/

# Personal files that live in the working copy
agent/gui_settings.backup*.json
/*.zspr
